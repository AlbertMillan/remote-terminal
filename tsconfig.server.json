{
  // Typecheck gate for server code. Overrides the root config's DOM lib so a
  // server file can never reach for `document`/`window` and still compile.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/server/**/*"]
}
